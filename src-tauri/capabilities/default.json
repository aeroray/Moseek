{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Moseek desktop capability set",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/moseek-script-runtime",
          "sidecar": true
        }
      ]
    }
  ]
}
